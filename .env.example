# ============================================================
# 環境変数サンプル（このファイルはコミット可。実値は .env に書く）
# Vercel ではダッシュボードの Settings → Environment Variables に登録します。
# ============================================================

# Supabase（Project Settings → API から取得）
SUPABASE_URL=https://xxxx.supabase.co
# service_role キー：サーバー（互換API/移行スクリプト）専用。絶対にフロントへ出さない。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# セッショントークン署名用のランダムな秘密鍵（例: openssl rand -hex 32 で生成）
SESSION_SECRET=replace-with-long-random-string

# 既存データ移行スクリプト用（現行 GAS のデプロイURL）
GAS_URL=https://script.google.com/macros/s/AKfycbwrz7LgQb2uH9VTtmalZxIEcJnHc-Ae53UNMnDi0MM5eLdP7XmZKOlDPTaOL5pmsFwf/exec
