# =====================================================================
# vie Dashboard — 環境変数サンプル
# 用途ごとに設定場所が異なります。詳細は docs/SUPABASE_MIGRATION.md 参照。
# =====================================================================

# ── (A) Vercel（フロント配信）: Settings > Environment Variables ──────
#   静的サイトのため config.js にビルド時注入されます（gen-config.mjs）。
#   anon key は公開可（RLS前提）。service_role はここに置かない。
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...anon_public_key
BACKEND_MODE=supabase                 # supabase | gas（省略時 supabase）

# ── (B) Supabase Edge Function（Claude中継 / AIアドバイス・AIコーチ・AI面談評価）─
#   supabase secrets set KEY=VALUE で設定（フロントには出ない）。
ANTHROPIC_API_KEY=sk-ant-...your_anthropic_key
ANTHROPIC_MODEL=claude-opus-4-8       # 省略可（Haiku等に変更可）
# ANTHROPIC_MAX_TOKENS=2048           # 省略可

# ── (C) データ移行スクリプト scripts/migrate-from-gas.mjs（ローカル実行）─
#   service_role は絶対に公開・コミットしないこと。
GAS_URL=https://script.google.com/macros/s/XXXXX/exec
# SUPABASE_URL=（上と同じ）
SUPABASE_SERVICE_KEY=eyJhbGciOiJI...service_role_key
